# Discord Bot
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_id

# Google AI (Gemini) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Hugging Face - https://huggingface.co/settings/tokens
HF_API_TOKEN=your_hugging_face_token

# OpenWeatherMap - https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# Genius - https://genius.com/api-clients
GENIUS_API_KEY=your_genius_api_key

# ExchangeRate API - https://www.exchangerate-api.com/
EXCHANGE_API_KEY=your_exchange_rate_api_key

# Optional Ethereum JSON-RPC endpoint. Defaults to PublicNode when empty.
ETHEREUM_RPC_URL=

# Last.fm - https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key

# Optional public-data integrations
# GitHub works without a token at lower rate limits.
GITHUB_TOKEN=
# Spotify search uses the Client Credentials flow.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# YouTube video and channel search.
YOUTUBE_API_KEY=
# Steam profiles and achievements. /steam game works without it.
STEAM_API_KEY=

# The Cat API (optional) - https://thecatapi.com/
CAT_API_KEY=your_cat_api_key

# ez.host uploads (optional) - required only by /ezhost commands
EZHOST_API_KEY=

# Media downloads (optional)
# Override the yt-dlp binary. Leave empty to use bin/yt-dlp.exe on Windows,
# bin/yt-dlp_linux on Linux, or whatever is on PATH.
YTDLP_PATH=
# Use a Netscape-format cookies file when Instagram requires login.
YTDLP_COOKIES_FILE=
# Or read cookies from a local browser, for example: chrome or firefox.
YTDLP_COOKIES_BROWSER=
# Optional self-hosted Cobalt v11 fallback. Comma-separate multiple URLs.
COBALT_API_URLS=
COBALT_API_TOKEN=
COBALT_API_AUTH_SCHEME=Api-Key

# API Server Port
# Leave empty on Pterodactyl-style hosts (Wispbyte) so the bot uses the
# container's allocated SERVER_PORT instead.
API_PORT=3001

# Bot Owner IDs (comma-separated)
OWNER_IDS=your_discord_user_id
