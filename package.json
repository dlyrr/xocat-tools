{
  "name": "discord-multibot",
  "version": "1.0.0",
  "description": "Multi-feature Discord bot with maintained utility, media, Roblox, game, and finance commands",
  "main": "index.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "deploy-commands": "node deploy-commands.js",
    "dev": "node --watch index.js",
    "start": "node index.js",
    "test": "node scripts/smoke-effects.js && node scripts/smoke-prefix.js && node scripts/smoke-media.js",
    "test:effects": "node scripts/smoke-effects.js",
    "test:media": "node scripts/smoke-media.js",
    "test:prefix": "node scripts/smoke-prefix.js"
  },
  "dependencies": {
    "@discordjs/rest": "^2.4.0",
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.5",
    "genius-lyrics": "^4.4.7",
    "node-html-parser": "^6.1.13",
    "sharp": "^0.34.5",
    "sql.js": "^1.11.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "jscodeshift": "^17.3.0"
  }
}
